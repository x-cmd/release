# shellcheck shell=dash
# 同步 x-cmd/release 到 gitee.com 与 gitcode.net 镜像仓库

(
    [ -d release ] || command git clone git@github.com:x-cmd/release || exit 1
    ___x_cmd_cmds_cd release || {
        x:error "Cannot cd to release"
        exit 1
    }

    x:info "正在同步 x-cmd/release 到 gitee.com 仓库"
    command git push git@gitee.com:x-cmd/release main   || exit 1

    x:info "正在同步 x-cmd/release 到 gitcode.net 仓库"
    command git push git@gitcode.net:x-cmd/release main || exit 1
)
